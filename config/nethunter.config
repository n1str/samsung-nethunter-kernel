# NetHunter config fragment for SM-A920F (a9y18qlte), kernel 4.4.205.
# Merged on top of a9y18qlte_eur_open_defconfig via scripts/kconfig/merge_config.sh,
# then `make olddefconfig`. Do not hand-edit .config. See CONFIG_CHANGES.md for rationale.

# --- 802.11 stack + injection ---
CONFIG_CFG80211=y
CONFIG_MAC80211=y

# --- AR9271 external adapter (ath9k_htc) ---
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HW=y
CONFIG_ATH9K_COMMON=y
CONFIG_ATH9K_HTC=y

# --- external realtek RTL8812AU/8814AU (out-of-tree driver, patch 08) ---
# Disabled: the 88xxau driver trips Samsung's scripts/gcc-wrapper.py "forbidden
# warning" check (empty declaration @ rtw_mlme_ext.c:261, and likely more). It is a
# secondary adapter; the primary AR9271 (ath9k_htc) builds fine. Patch-08 files stay
# in-tree but unbuilt. Re-enable only after cleaning the driver's warnings.
# CONFIG_88XXAU is not set

# --- USB gadget: HID attacks + networking (ECM/RNDIS/FunctionFS) ---
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y

# --- external bluetooth (optional) ---
CONFIG_BT_HCIBTUSB=y

# --- loadable modules, unsigned ---
CONFIG_MODULES=y
CONFIG_MODULE_FORCE_LOAD=y
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_ALL is not set

# --- disable Samsung security that breaks root / module loading ---
# CONFIG_SECURITY_DEFEX is not set
# CONFIG_FIVE is not set
# CONFIG_FIVE_TEE_DRIVER is not set
# CONFIG_FIVE_EARLY_LOAD_TRUSTED_APP is not set
# CONFIG_FIVE_TRUSTED_KEYRING is not set
# CONFIG_PROCA is not set
# CONFIG_SECURITY_DSMS is not set
# CONFIG_KNOX_KAP is not set
# CONFIG_TIMA is not set
# CONFIG_TIMA_LOG is not set
# CONFIG_TIMA_LKMAUTH is not set
# CONFIG_TIMA_UEVENT is not set
